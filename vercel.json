{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": true,
  "redirects": [
    { "source": "/about.html", "destination": "/about/", "permanent": true },
    { "source": "/MissionVision.html", "destination": "/about/", "permanent": true },
    { "source": "/Infrastructure.html", "destination": "/campus-life/", "permanent": true },
    { "source": "/gallery.php", "destination": "/gallery/", "permanent": true },
    { "source": "/contact.html", "destination": "/contact/", "permanent": true },
    { "source": "/Contact.html", "destination": "/contact/", "permanent": true },
    { "source": "/mandatory-disclosure.php", "destination": "/mandatory-disclosure/", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "(.*)\\.vercel\\.app" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/(ikat.svg|favicon.png|og.jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
