---
// A sentence, not a form: three taps and WhatsApp opens with the message written.
import ClassSelect from './ClassSelect.astro'; import CampusSelect from './CampusSelect.astro';
---
<form class="ask" data-ask>
  <p>
    My child is joining <ClassSelect value="Class 1" /> and we live near <CampusSelect />. We would like
    <select name="mode" aria-label="Kind of schooling" data-pick="cards" data-label="Kind of schooling"><option data-note="Regular school hours, home by evening">day school</option><option data-note="A longer, supervised day on campus">day boarding</option><option data-note="Living on campus through the term">boarding</option></select>.
  </p>
  <button class="btn gold" type="submit">Ask on WhatsApp</button>
</form>
