---
import Ask from './Ask.astro';
import { tel, phone } from '../site';
---
<section class="close"><div class="wrap">
  <h2>Come and see it for yourself.</h2>
  <p class="lead">Walk through a classroom, meet a teacher, ask about fees and transport. Tell us one line about your child and we will take it from there.</p>
  <Ask />
  <p>Prefer to talk? <a href={tel}>Call {phone}</a></p>
</div></section>
