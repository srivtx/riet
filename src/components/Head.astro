---
import Pic from './Pic.astro';
interface Props { title: string; lead: string; img?: string; alt?: string; pos?: string; sky?: string; flip?: boolean }
const { title, lead, img, alt = '', pos = 'center', sky, flip } = Astro.props;
---
<section class:list={['page-head', { bare: !img, flip }]}>
  {sky && <Pic pic="sky" name={`sky-${sky}`} alt="" sizes="max(100vw, 700px)" now />}
  <div class="wrap">
  <div><h1>{title}</h1><p class="lead">{lead}</p></div>
  {img && <div class="arch"><Pic name={img} alt={alt} sizes="(max-width:800px) 92vw, 46vw" now style={`object-position:${pos}`} /></div>}
</div></section>
