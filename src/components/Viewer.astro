---
// One photo viewer for the whole site. See scripts/viewer.ts
---
<dialog class="viewer" aria-label="Photo viewer">
  <div class="v-track" tabindex="-1"></div>
  <p class="v-cap" aria-live="polite"><b></b><span></span></p>
  <button class="v-btn v-prev" aria-label="Previous photo"></button>
  <button class="v-btn v-next" aria-label="Next photo"></button>
  <button class="v-close">Close</button>
  <div class="v-strip"></div>
</dialog>
