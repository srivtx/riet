---
import Close from '../components/Close.astro';
import Viewer from '../components/Viewer.astro';
import Pic from '../components/Pic.astro';
import Base from '../layouts/Base.astro'; import Head from '../components/Head.astro';
import { getImage } from 'astro:assets'; import { img } from '../site';
const items = [['assembly-cheer','A day out together','Trips'],['sambalpuri-dance','Sambalpuri dance','Culture'],['sports-march','Annual Sports, VSS Nagar','Sports'],['science-fair','Science Fair','Learning'],['saraswati-puja','Saraswati Puja','Culture'],['classical-dance','Annual function','Culture'],['science-centre','Regional Science Centre','Trips'],['sports-podium','Winners','Sports'],['christmas','Christmas','Culture'],['campus-ground','Campus','Campus'],['study-tour','Study tour','Trips'],['foundation-day','16th Foundation Day','Culture'],['raksha-bandhan','Raksha Bandhan','Culture'],['annual-exam','Annual exam','Learning'],['group-dance','On stage','Culture'],['school-bus','The yellow bus','Trips'],['cbse-welcome','CBSE affiliation','Learning'],['campus-entrance','Campus entrance','Campus']];
const full = await Promise.all(items.map(async ([i]) => (await getImage({ src: img(i), format: 'webp', width: Math.min(1400, img(i).width), quality: 68 })).src));
const cats = ['All','Culture','Sports','Trips','Learning','Campus'];
---
<Base title="Gallery | RIET International School" description="Photos from festivals, sports, study tours and classrooms at RIET International School.">
  <Head sky="temple" title="This is what school feels like." lead="Real days, real students, no stock photos." />
  <section class="wrap gal">
    <div class="chips" role="group" aria-label="Filter photos">{cats.map((c, i) => <button aria-pressed={i === 0 ? 'true' : 'false'} data-c={c}>{c} <small>{c === 'All' ? items.length : items.filter(i => i[2] === c).length}</small></button>)}</div>
    <div class="mosaic">{items.map(([i, t, c], n) => <button class:list={{ big: [0, 1, 5, 9, 11, 15].includes(n) }} data-cat={c} data-full={full[n]} data-w={img(i).width} data-h={img(i).height} data-t={t}><Pic name={i} alt={t} sizes="(max-width:800px) 92vw, 46vw" now={n < 2} /><span>{t}</span></button>)}</div>
  </section>
  <Viewer />
  <Close />
</Base>
<script>
  import { view, type Shot } from '../scripts/viewer';
  const g = [...document.querySelectorAll<HTMLButtonElement>('.mosaic button')], chips = [...document.querySelectorAll<HTMLButtonElement>('.chips button')], m = document.querySelector('.mosaic')!;
  chips.forEach(b => b.onclick = () => {
    chips.forEach(x => x.setAttribute('aria-pressed', String(x === b))); const all = b.dataset.c === 'All'; m.classList.toggle('few', !all);
    g.forEach(x => { x.hidden = !all && x.dataset.cat !== b.dataset.c; if (!x.hidden) x.animate({ opacity: [.2, 1], scale: ['.97', '1'] }, { duration: 260, easing: 'ease-out' }); });
  });
  const list = (): Shot[] => g.filter(b => !b.hidden).map(b => ({ el: b, img: b.querySelector('img')!, full: b.dataset.full!, w: +b.dataset.w!, h: +b.dataset.h!, t: b.dataset.t! }));
  g.forEach(b => b.onclick = () => { const l = list(); view(l, l.findIndex(s => s.el === b)); });
  // Fetch the sharp version while the finger or cursor is on its way
  g.forEach(b => b.addEventListener('pointerenter', () => { if (!(navigator as any).connection?.saveData) new Image().src = b.dataset.full!; }, { once: true }));
</script>
