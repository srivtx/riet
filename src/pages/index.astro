---
import Base from '../layouts/Base.astro';
import Sun from '../components/Sun.astro';
import Ask from '../components/Ask.astro';
import Close from '../components/Close.astro';
import { Image, getImage } from 'astro:assets';
import { img, campuses, videos, wa } from '../site';
const hero = await getImage({ src: img('assembly-cheer'), width: 1440, format: 'webp' });
const year = [
  ['Foundation Day', 'foundation-day', 'In January 2026 the school turned sixteen, and celebrated the way every birthday should be: with cake.'],
  ['Science Fair', 'science-fair', 'Students build it, explain it and defend it in front of teachers and parents.'],
  ['Saraswati Puja', 'saraswati-puja', 'Books rest for a morning while the school asks for the blessing of learning.'],
  ['Annual Sports', 'sports-march', 'A march past, medals and a podium worth training for.'],
  ['Raksha Bandhan', 'raksha-bandhan', 'The hall fills up for stories, songs and a promise to look out for each other.'],
  ['Study Tour', 'study-tour', 'A day out where the lesson is under your feet, not on the board.'],
  ['Annual Function', 'annual-function', 'RIET Jayanta: lights, costumes and a first time on stage for many.'],
  ['Christmas', 'christmas', 'Santa caps from the smallest class to the tallest teacher.'],
].map(([t, i, d]) => ({ t, i, d }));
const asks = [
  ['Is it a recognised school?', 'Our Thakurpatna campus is CBSE affiliated for Classes 1 to 12, No. 1530488. The letter is online for you to read.', '/documents/cbse-affiliation-letter.pdf', 'Read the letter'],
  ['Who will teach my child?', 'Trained PGT, TGT and PRT teachers, with a special educator and counsellors on the team.', '/academics/', 'See how we teach'],
  ['How will they get to school?', 'RIET runs its own buses and vans. Ask us whether your street is on a route.', wa('Hello RIET, does the school bus cover my area? I live in '), 'Check my area'],
  ['What does it cost?', 'Fees depend on class and on day, day boarding or boarding. We send the current sheet directly.', wa('Hello RIET, please share the fee structure for Class '), 'Get the fee sheet'],
];
---
<Base title="RIET International School | Bhubaneswar and Jajpur Road" description="Day school, day boarding and boarding from Pre-Nursery to Class 12 in Bhubaneswar and Jajpur Road, Odisha. RIET International School, inspiring children to dream since 2010.">
  <section class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <h1>Big dreams start close to home.</h1>
        <p class="lead">Pre-Nursery to Class 12 in Bhubaneswar and Jajpur Road. Day school, day boarding and boarding, since 2010.</p>
        <p class="acts"><a class="btn" href="/admissions/#enquire">Plan a school visit</a><a class="more" href="/campus-life/">Look around campus</a></p>
      </div>
      <div class="hero-sun"><Sun id="hero-clip" src={hero.src} focus="xMidYMid" alt="RIET students in red, orange and green cheering with their teachers, framed by the school's sun emblem" /></div>
    </div>
    <div class="plinth"><div class="wrap"><Ask /></div></div>
  </section>

  <section class="wrap asks">
    <h2>The four things every parent asks us first</h2>
    <div>{asks.map(([q, a, h, l]) => <article><h3>{q}</h3><p>{a}</p><a class="more" href={h}>{l}</a></article>)}</div>
  </section>

  <section class="year" aria-labelledby="yh">
    <div class="wrap">
      <div class="year-head"><h2 id="yh">A year under the RIET sun</h2><p>Pick a ray. Each one is a day our students talk about for months.</p></div>
      <div class="dial" data-dial>
        <div class="dial-sun">
          <svg viewBox="0 0 1000 520" aria-hidden="true">
            {year.map((_, i) => <polygon class="dray" data-i={i} points="0,-9 400,-30 515,0 400,30 0,9" transform={`translate(500 520) rotate(${-168 + i * 22.3})`} />)}
            <path d="M120 520A380 380 0 0 1 880 520Z" class="ring" />
          </svg>
          <div class="frames">{year.map((y, i) => <Image src={img(y.i)} alt={y.t} widths={[480, 900]} sizes="(max-width:800px) 80vw, 720px" class={i === 6 ? 'on' : ''} />)}</div>
        </div>
        <div class="tabs" role="tablist" aria-label="School events">{year.map((y, i) => <button role="tab" id={`t${i}`} aria-controls="dial-text" aria-selected={i === 6 ? 'true' : 'false'} tabindex={i === 6 ? 0 : -1} data-d={y.d}>{y.t}</button>)}</div>
        <p class="dial-text" id="dial-text" role="tabpanel" aria-live="polite">{year[6].d}</p>
      </div>
    </div>
  </section>

  <section class="founder"><div class="wrap">
    <Image src={img('founder')} alt="Er. Janmejaya Rout, Founder of RIET" width={478} />
    <div>
      <blockquote>My mission is to create a niche where learning will not be just a series of instructions but a passion.</blockquote>
      <p><b>Er. Janmejaya Rout</b><br />Founder, 28+ years of excellence</p>
      <a class="more" href="/about/">What we believe</a>
    </div>
  </div></section>

  <section class="wrap stages">
    <div><h2>From first letters to final boards</h2><p class="lead">One school family across every stage, so your child never has to start over.</p><a class="more" href="/academics/">How we teach</a></div>
    <ol>
      <li><b>Pre-Nursery to UKG</b><span>Play, stories, songs, and the confidence to speak up.</span></li>
      <li><b>Class 1 to 5</b><span>Reading, number sense and curiosity about everything.</span></li>
      <li><b>Class 6 to 8</b><span>Labs, computers and Olympiads.</span></li>
      <li><b>Class 9 to 12</b><span>Focused preparation for board exams and what follows.</span></li>
    </ol>
  </section>

  <section class="culture">
    <Image src={img('sambalpuri-dance')} alt="Three young students in Sambalpuri costume on stage at the annual function" widths={[700, 1440]} sizes="100vw" />
    <div class="ikat" aria-hidden="true"></div>
    <div class="wrap"><h2>Ready for the world. Rooted in Odisha.</h2><p>Olympiads and computers on weekdays, Sambalpuri steps on stage. Our students grow up at ease with both.</p><a class="more" href="/gallery/">See the gallery</a></div>
  </section>

  <section class="wrap videos"><h2>Hear it from the people here</h2>
    <div>{videos.map(v => <a href={`https://www.youtube.com/watch?v=${v.id}`}><Image src={img(v.img)} alt="" widths={[420, 800]} sizes="(max-width:800px) 92vw, 33vw" /><b>{v.title}</b><span>Watch on YouTube, {v.time}</span></a>)}</div>
  </section>

  <section class="wrap near"><h2>Three campuses, one family</h2>
    <div>{campuses.map(c => <a href={c.map}><b>{c.name}</b><i>{c.city}</i><span>{c.lines}</span><em>{c.note}</em><u>Directions</u></a>)}</div>
  </section>
  <Close />
</Base>
<script>
  const root = document.querySelector('[data-dial]')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')], rays = [...root.querySelectorAll('.dray')], pics = [...root.querySelectorAll('.frames img')], txt = root.querySelector('.dial-text')!;
  const go = (i: number, focus = false) => {
    tabs.forEach((t, n) => { t.setAttribute('aria-selected', String(n === i)); t.tabIndex = n === i ? 0 : -1; });
    rays.forEach((r, n) => r.classList.toggle('on', n === i)); pics.forEach((p, n) => p.classList.toggle('on', n === i));
    txt.textContent = tabs[i].dataset.d!; if (focus) tabs[i].focus();
  };
  tabs.forEach((t, i) => { t.onclick = () => go(i); t.onkeydown = e => { const k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (k) go((i + k + tabs.length) % tabs.length, true); }; });
  rays.forEach((r, i) => r.addEventListener('click', () => go(i))); go(6);
</script>
