---
import Pic from '../components/Pic.astro';
import Base from '../layouts/Base.astro';
import Sun from '../components/Sun.astro';
import Ask from '../components/Ask.astro';
import Films from '../components/Films.astro';
import Near from '../components/Near.astro';
import ClassFinder from '../components/ClassFinder.astro';
import Founder from '../components/Founder.astro';
import Stages from '../components/Stages.astro';
import Year from '../components/Year.astro';
import Worry from '../components/Worry.astro';
import Close from '../components/Close.astro';
import { img, wa } from '../site';
const asks = [
  ['Is it a recognised school?', 'Our Thakurpatna campus is CBSE affiliated for Classes 1 to 12, No. 1530488. The letter is online for you to read.', '/documents/cbse-affiliation-letter.pdf', 'Read the letter', 'art-certificate'],
  ['Who will teach my child?', 'Trained PGT, TGT and PRT teachers, with a special educator and counsellors on the team.', '/academics/', 'See how we teach', 'art-book'],
  ['How will they get to school?', 'RIET runs its own buses and vans. Ask us whether your street is on a route.', wa('Hello RIET, does the school bus cover my area? I live in '), 'Check my area', 'art-bus'],
  ['What does it cost?', 'Fees depend on class and on day, day boarding or boarding. We send the current sheet directly.', wa('Hello RIET, please share the fee structure for Class '), 'Get the fee sheet', 'art-pot'],
];
---
<Base title="RIET International School | Bhubaneswar and Jajpur Road" description="Day school, day boarding and boarding from Pre-Nursery to Class 12 in Bhubaneswar and Jajpur Road, Odisha. RIET International School, inspiring children to dream since 2010.">
  <section class="hero">
    <Pic pic="sky" name="sky-temple" alt="" sizes="max(100vw, 700px)" now />
    <div class="wrap">
      <div class="hero-copy">
        <h1>Big dreams start close to home.</h1>
        <p class="lead">Pre-Nursery to Class 12 in Bhubaneswar and Jajpur Road. Day school, day boarding and boarding, since 2010.</p>
        <p class="acts"><a class="btn" href="/admissions/#visit">Plan a school visit</a><a class="more" href="/campus-life/">Look around campus</a></p>
      </div>
      <div class="hero-sun"><Sun name="assembly-cheer" alt="RIET students in red, orange and green cheering with their teachers, framed by the school's sun emblem" /></div>
    </div>
    <div class="plinth"><div class="wrap"><Ask /></div></div>
  </section>

  <section class="wrap asks">
    <h2>The four things every parent asks us first</h2>
    <div>{asks.map(([q, a, h, l, i]) => <article class={i}><div><h3>{q}</h3><p>{a}</p><a class="more" href={h}>{l}</a></div><Pic name={i} alt="" sizes="(max-width:800px) 150px, 262px" max={560} /></article>)}</div>
  </section>

  <Year />

  <Founder />

  <Stages more />

  <ClassFinder />

  <section class="culture">
    <Pic name="sambalpuri-dance" alt="Three young students in Sambalpuri costume on stage at the annual function" sizes="100vw" />
    <div class="ikat" aria-hidden="true"></div>
    <div class="wrap"><h2>Ready for the world. Rooted in Odisha.</h2><p>Olympiads and computers on weekdays, Sambalpuri steps on stage. Our students grow up at ease with both.</p><a class="more" href="/gallery/">See the gallery</a></div>
  </section>

  <Worry />
  <Films />

  <Near title="Three campuses, one family" />
  <Close />
</Base>
