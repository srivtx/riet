---
import Pic from '../components/Pic.astro';
import Base from '../layouts/Base.astro'; import Head from '../components/Head.astro'; import Tiles from '../components/Tiles.astro'; import Road from '../components/Road.astro'; import Close from '../components/Close.astro';
import { img } from '../site';
const groups = [['Learn','','art-telescope','Smart classrooms','Physics, chemistry and biology labs','Computer lab','Library and digital resources'],['Create','','art-drum','Art studio','Music room','Performance space for drama and dance'],['Play','','art-ball','Outdoor sports and playgrounds','Indoor games','Fitness areas'],['Feel cared for','','art-tiffin','Clean, hygienic dining','Health and wellness support','Counselling','Campus safety measures']];
---
<Base title="Campus life | RIET International School" description="Classrooms, labs, library, sports, arts, transport and student care at RIET International School.">
  <Head sky="hills" title="Room to run, space to think." lead="Safe, stimulating campuses with natural light, green spaces and purpose-built rooms for every kind of learner." img="campus-ground" alt="Students playing in front of the campus building" pos="60% 60%" />
  <section class="wrap facts"><h2>Thakurpatna campus in numbers</h2><dl><div><dd>6,075</dd><dt>square metres of campus</dt></div><div><dd>35</dd><dt>classrooms of 46 sqm</dt></div><div><dd>6</dd><dt>labs, including computers</dt></div><div><dd>27</dd><dt>teachers</dt></div></dl><p>As declared in our <a href="/mandatory-disclosure/">mandatory public disclosure</a>.</p></section>
  <Tiles title="A day has room for all of it" cols={4} items={groups} />
  <Road />
  <section class="partners"><div class="wrap"><div><h2>On the podium</h2><p class="lead">Annual Sports brings out the team player in everyone.</p><p>A march past, medals and the whole school cheering.</p><a class="more" href="/gallery/">More from the year</a></div><div class="arch"><Pic name="sports-podium" alt="Winners on the podium at Annual Sports" sizes="(max-width:800px) 92vw, 46vw" style="object-position:50% 30%" /></div></div></section>
  <Close />
</Base>
