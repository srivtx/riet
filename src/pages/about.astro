---
import Pic from '../components/Pic.astro';
import Base from '../layouts/Base.astro'; import Head from '../components/Head.astro'; import Founder from '../components/Founder.astro'; import Grow from '../components/Grow.astro'; import Tiles from '../components/Tiles.astro'; import Close from '../components/Close.astro';
const values = [['Excellence','We set high expectations for learning, for conduct and for ourselves.','art-medal'],['Integrity','Honesty, transparency and moral courage, in class and out of it.','art-scale'],['Respect','Every individual has inherent worth. Diversity makes us stronger.','art-lotus'],['Innovation','We encourage creative thinking and welcome new ideas.','art-bulb'],['Collaboration','Students, parents and community, woven into one team.','art-basket'],['Compassion','We meet every child with empathy, kindness and genuine concern.','art-nest']];
---
<Base title="About | RIET International School" description="The story, founder, vision, mission and values of RIET International School, Odisha.">
  <Head sky="river" flip title="A school built on one belief: every child can dream bigger." lead="RIET International School is a vibrant community where students from diverse backgrounds grow academically, take part actively and build lasting experiences." img="campus-entrance" alt="Entrance of the RIET campus building" />
  <Founder look="bandhgala" heading="From our founder" />
  <Grow />
  <Tiles title="Six values, lived daily" items={values} />
  <section class="partners"><div class="wrap"><div class="arch"><Pic name="science-fair" alt="Students and teachers together at the Science Fair" sizes="(max-width:800px) 92vw, 46vw" style="object-position:50% 38%" /></div><div><h2>Families are partners</h2><p class="lead">Success is shared. We keep families informed and involved through open communication, and we work together on each student’s development.</p><a class="more" href="/admissions/#checklist">Eight questions to ask any school</a></div></div></section>
  <Close />
</Base>
