---
import Base from '../layouts/Base.astro'; import Head from '../components/Head.astro';
import ClassSelect from '../components/ClassSelect.astro'; import CampusSelect from '../components/CampusSelect.astro'; import ClassFinder from '../components/ClassFinder.astro'; import Checklist from '../components/Checklist.astro';
import { img, tel, phone, email, hours } from '../site';
const steps = [['Say hello','Send the enquiry below or call. Our admissions team aims to contact you within 24 hours.'],['Visit','Walk the campus, meet teachers and bring your child along.'],['Decide together','We guide you through class placement, fees, transport and boarding.'],['Join','Complete the paperwork and come in for day one.']];
const faq = [
  ['Is RIET affiliated to CBSE?','The Thakurpatna campus at Jajpur Road holds CBSE affiliation No. 1530488 for Classes 1 to 12, from 1 April 2026 to 31 March 2031. For the other campuses, please ask us about the board and class availability.'],
  ['When will the first CBSE board batch appear?','According to the affiliation letter, the first Class 10 and 12 batches will appear in 2028.'],
  ['Which classes can my child join?','Enquiries are open from Pre-Nursery to Class 12. Availability differs by campus, so tell us which one suits you.'],
  ['What is the difference between day school and day boarding?','Day school follows regular school hours. Day boarding gives your child a longer day on campus. Ask us for the current timings.'],
  ['Where can I see fees?','We share the fee sheet for your class and campus directly. Choose Fee structure in the enquiry form.'],
];
---
<Base title="Admissions | RIET International School" description="How to join RIET International School, Pre-Nursery to Class 12. Enquire on WhatsApp, plan a visit and get the fee structure.">
  <Head title="Four steps to the first day of school." lead="No long forms. No pressure. Just a conversation about your child." img={img('school-bus')} alt="Students smiling in front of the RIET bus" />
  <section class="wrap steps"><ol>{steps.map(([a,b]) => <li><b>{a}</b><span>{b}</span></li>)}</ol></section>
  <ClassFinder />
  <section class="tint" id="enquire"><div class="wrap duo">
    <div><h2>Enquire now</h2><p class="lead">Fill this in and WhatsApp opens with your message ready to send. Nothing is stored on this website.</p><p><a href={tel}>{phone}</a><br /><a href={`mailto:${email}`}>{email}</a><br />{hours}</p></div>
    <form class="form" id="enq" novalidate>
      <label>Your name<input name="name" required autocomplete="name" /></label>
      <label>Mobile number<input name="mobile" type="tel" inputmode="numeric" pattern="[0-9]{10}" title="10 digit mobile number" required autocomplete="tel-national" /></label>
      <label>Class<ClassSelect required blank="Choose a class" /></label>
      <label>Campus<CampusSelect /></label>
      <label class="full">I want to know about<select name="about" data-pick="list" data-label="I want to know about"><option>Admission process</option><option>Fee structure</option><option>School visit</option><option>Curriculum</option><option>Transport</option><option>Boarding</option><option>Something else</option></select></label>
      <label class="full">Anything else (optional)<textarea name="msg" rows="3"></textarea></label>
      <div class="full preview"><p>The message we will receive</p><div aria-live="off"></div></div>
      <p class="full oops" role="alert"></p>
      <p class="full acts"><button class="btn" type="submit" value="wa">Continue on WhatsApp</button><button class="btn line" type="submit" value="mail">Send by email</button></p>
    </form>
  </div></section>
  <Checklist />
  <section class="wrap faq"><h2>Good questions</h2><div>{faq.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
</Base>
<script>
  import { wa, email } from '../site';
  const f = document.querySelector<HTMLFormElement>('#enq')!, box = f.querySelector('.preview div')!, oops = f.querySelector('.oops')!;
  const text = () => { const d = new FormData(f), g = (k: string) => String(d.get(k) || '').trim();
    return ['Admission enquiry', `Name: ${g('name') || '…'}`, `Mobile: ${g('mobile') || '…'}`, `Class: ${g('grade') || '…'}`, `Campus: ${g('campus')}`, `About: ${g('about')}`, g('msg') && `Message: ${g('msg')}`].filter(Boolean).join('\n'); };
  const show = () => { box.textContent = text(); };
  f.addEventListener('input', e => { (e.target as Element).removeAttribute('aria-invalid'); if (f.checkValidity()) oops.textContent = ''; show(); }); show();
  // Keep only digits, and forgive a typed +91 or leading zero
  const m = f.elements.namedItem('mobile') as HTMLInputElement;
  m.addEventListener('change', () => { let v = m.value.replace(/\D/g, ''); if (v.length === 12 && v.startsWith('91')) v = v.slice(2); if (v.length === 11 && v[0] === '0') v = v.slice(1); m.value = v; show(); });
  f.addEventListener('submit', e => {
    e.preventDefault();
    if (!f.checkValidity()) {
      const bad = [...f.querySelectorAll<HTMLInputElement>(':invalid')]; bad.forEach(x => x.setAttribute('aria-invalid', 'true'));
      const say: Record<string, string> = { name: 'your name', mobile: 'a 10 digit mobile number', grade: 'a class' };
      oops.textContent = `Please add ${new Intl.ListFormat('en-IN').format(bad.map(x => say[x.name]))}.`; if (bad[0].name !== 'grade') bad[0].focus(); return;
    }
    const t = text();
    if ((e.submitter as HTMLButtonElement)?.value === 'mail') location.href = `mailto:${email}?subject=${encodeURIComponent('Admission enquiry')}&body=${encodeURIComponent(t)}`;
    else window.open(wa(t), '_blank', 'noopener');
  });
</script>
