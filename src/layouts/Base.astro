---
import '@fontsource-variable/anek-latin/wdth.css';
import '@fontsource-variable/anek-odia/wght.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import { nav, wa, tel, phone, email, campuses, social, img, hours } from '../site';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const url = new URL(path, Astro.site);
const ld = { '@context': 'https://schema.org', '@type': 'School', name: 'RIET International School', url: String(Astro.site), telephone: phone, email, foundingDate: '2010', slogan: 'Inspires to Dream', address: { '@type': 'PostalAddress', streetAddress: 'RIET House, 4755, VSS Nagar', addressLocality: 'Bhubaneswar', addressRegion: 'Odisha', postalCode: '751010', addressCountry: 'IN' }, sameAs: social.map(s => s[1]) };
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <link rel="icon" href="/favicon.png" />
  <meta name="theme-color" content="#d9241b" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:image" content={new URL('/og.jpg', Astro.site)} /><meta property="og:url" content={url} /><meta name="twitter:card" content="summary_large_image" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <slot name="head" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top"><div class="wrap">
    <a class="logo" href="/" aria-label="RIET International School, home"><Image src={img('logo')} alt="RIET International School, Inspires to Dream" height={152} width={197} loading="eager" /></a>
    <button class="burger" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav id="nav" aria-label="Main">
      {nav.map(([t, h]) => <a href={h} aria-current={path === h ? 'page' : undefined}>{t}</a>)}
      <a class="btn" href="/admissions/#enquire">Enquire</a>
    </nav>
  </div></header>
  <main id="main"><slot /></main>
  <footer>
    <div class="ikat" aria-hidden="true"></div>
    <div class="wrap">
      <div class="foot-brand"><span class="disc"><Image src={img('logo')} alt="RIET International School" width={180} /></span>
        <p lang="or" class="or">ସ୍ୱପ୍ନ ଦେଖିବାର ପ୍ରେରଣା</p><p>Inspires to Dream, since 2010.<br />Part of RIET Group of Institutions.</p></div>
      <div><h3>Campuses</h3>{campuses.map(c => <p><b>{c.name}</b><br />{c.lines}<br /><a href={c.map}>Directions</a></p>)}</div>
      <div><h3>Talk to us</h3><p><a href={tel}>{phone}</a><br /><a href={`mailto:${email}`}>{email}</a><br />{hours}<br /><span data-open></span></p>
        <p>{social.map(([t, h]) => <><a href={h}>{t}</a><br /></>)}</p></div>
      <div><h3>The school</h3><p>{nav.map(([t, h]) => <><a href={h}>{t}</a><br /></>)}<a href="/mandatory-disclosure/">Mandatory public disclosure</a></p></div>
      <p class="legal">© {new Date().getFullYear()} RIET International School. All rights reserved.</p>
    </div>
  </footer>
  <div class="bar"><a href={tel}>Call</a><a class="w" href={wa()}>WhatsApp</a><a href="/contact/">Find us</a></div>
  <script>import '../scripts/site';</script>
</body>
</html>
